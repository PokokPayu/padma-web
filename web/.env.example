NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dari-supabase-start
SUPABASE_SERVICE_ROLE_KEY=isi-dari-supabase-start

# Koneksi SQL langsung — hanya untuk test struktural (lihat tests/helpers/db.ts).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Jumlah proxy TEPERCAYA di depan aplikasi (Vercel/Nginx = 1). Menentukan hop
# X-Forwarded-For mana yang dipakai sebagai kunci rate limit /api/skrining.
# 0 = tidak ada proxy: X-Forwarded-For diabaikan total (header itu dikendalikan
# klien; memercayainya = rate limit bisa dilewati dengan memutar nilainya).
# Kosong/tidak diisi = 1.
PADMA_PROXY_TEPERCAYA=1
